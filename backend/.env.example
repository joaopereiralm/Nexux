NODE_ENV=development
PORT=3333

# Local: DATABASE_URL e DIRECT_URL devem apontar para o MESMO banco.
# Supabase (produção): DATABASE_URL = pooler (porta 6543, pgbouncer=true);
# DIRECT_URL = conexão direta (porta 5432), usada pelas migrações.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO?schema=public"
DIRECT_URL="postgresql://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO?schema=public"

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-chars-ou-mais
JWT_EXPIRES_IN=7d

# Origens autorizadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173
